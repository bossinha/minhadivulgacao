rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bossinhaa80@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Tenants Collection
    match /tenants/{tenantId} {
      allow get: if isValidId(tenantId);
      allow list: if isAdmin();
      
      allow create: if isValidId(tenantId) && 
                      !exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
                      request.resource.data.keys().hasAll(['city', 'password', 'data', 'isAdmin']) &&
                      request.resource.data.isAdmin == false;
      
      allow update, delete: if isAdmin();
      
      allow update: if isValidId(tenantId) && (
        request.resource.data.password == resource.data.password &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data'])
       );

      // Affiliates Sub-collection
      match /affiliates/{affiliateId} {
        allow get: if isValidId(affiliateId);
        allow list: if true;
        
        // Public increment for clicks
        allow update: if (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) &&
          request.resource.data.clicks is number
        );

        // Management writes (needs portal password or Admin)
        allow write: if isAdmin() || 
          (request.resource.data._auth == get(/databases/$(database)/documents/tenants/$(tenantId)).data.password) ||
          (resource != null && resource.data._auth == get(/databases/$(database)/documents/tenants/$(tenantId)).data.password);
      }
    }

    // Advertisers Collection (Individual Virtual Shops)
    match /advertisers/{advertiserId} {
      allow get, list: if true;
      allow create: if isValidId(advertiserId) && 
                      !exists(/databases/$(database)/documents/advertisers/$(advertiserId));
      allow update: if isValidId(advertiserId);
      allow delete: if isValidId(advertiserId);
    }

    // Dynamic Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Company Views & Real-time Stats
    match /company_views/{companyId} {
      allow read, write: if true;
    }

    // Company Dispatch Tracking (WhatsApp/Facebook Group Dispatches)
    match /dispatch_trackings/{trackingId} {
      allow read, write: if true;
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Push Notification Subscribers (Audience)
    match /push_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    // Push Notifications History and Stats
    match /push_notifications/{notificationId} {
      allow read, write: if true;
    }

    match /push_stats/{statId} {
      allow read, write: if true;
    }
  }
}
